=============================================================================================================
### Baixar o genoma humano, a anotação e conjunto de lncRNAs (GENCODE Release 40 GRCh38_primary_assembly) ###
=============================================================================================================

#!/bin/bash

# Homepage do GENCODE > FTP site > latest_release/
# Arquivos: GRCh38.primary_assembly.genome.fa.gz, gencode.v45.primary_assembly.annotation.gtf.gz, gencode.v45.transcripts.fa.gz, gencode.v45.pc_transcripts.fa.gz, gencode.v45.long_noncoding_RNAs.gtf.gz, gencode.v45.lncRNA_transcripts.fa.gz), de acordo com a necessidade.

#1 Create a tmux session:

tmux new -s gencodeDownload

wget https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/latest_release/GRCh38.primary_assembly.genome.fa.gz

#2 Descompactar os arquivos do genoma (.fa), anotação (.gtf) e lcnRNAs (.gtf) em seus respectivos diretórios

gunzip GRCh38.primary_assembly.genome.fa.gz &
