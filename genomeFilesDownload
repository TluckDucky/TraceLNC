===================================
### Human genome files download ###
===================================

#!/bin/bash

# Homepage do GENCODE > FTP site > latest_release/
# Files: GRCh38.primary_assembly.genome.fa.gz, gencode.v45.primary_assembly.annotation.gtf.gz, gencode.v45.transcripts.fa.gz, gencode.v45.pc_transcripts.fa.gz, gencode.v45.long_noncoding_RNAs.gtf.gz, gencode.v45.lncRNA_transcripts.fa.gz), according to user's need.

## 1. Create a tmux session and download each file ##
tmux new -s gencodeDownload

wget https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/latest_release/GRCh38.primary_assembly.genome.fa.gz

## 2. Decompress downloaded files in each respective directory ##
gunzip GRCh38.primary_assembly.genome.fa.gz &
