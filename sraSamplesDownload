==================================
### Raw RNA-Seq reads download ###
==================================

#!/bin/bash

## 1. Create directories for each SRA project and run the following

ll | grep -o "PRJNA[0-9]*" > projects.txt

## 2. Create subdirectories running the following

for i in `cat projects.txt`; do cd $i; mkdir {star,fastp,fastqc,gbc,infer,tin,rawData}; cd ..; done

for i in `cat projects.txt`; do cd ${i}/star; mkdir {indexes,1st,2nd}; cd ../..; done

## 1. In the rawData directory, create a txt list (SRAsamplesList.txt), containg the SRA NCBI samples accession number (SRR[0-9*) ##

while read x; do fasterq-dump ${x} -e 30 >& ${x}.log; done < SRAsamplesList.txt &

## 2. Symlinks to SRA fastq files of each SRA project into fastp/ and fastqc/ directories ##

