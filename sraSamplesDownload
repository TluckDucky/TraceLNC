# Check the Q30 percentages

for i in $(ls | grep -w "PRJNA.*"); do
    echo "$i"
    cd "$i/fastp/"
    for j in $(ls | grep -w "SRR.*log"); do
        echo "$j"
        grep "Q30" "$j"  
    done
    cd ../.. 
done
