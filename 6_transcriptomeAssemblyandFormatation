assembly_hipsc <- assembly_hipsc_backup

assembly_primary_backup <- assembly_primary
assembly_primary <- assembly_primary_backup

# Print column names

names(assembly_diff)

# Format column 2

assembly_diff$X2 <- "taco"
assembly_hipsc$X2 <- "taco"
assembly_primary$X2 <- "taco"

# Format column 9

