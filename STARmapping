## 2. For each RNA-Seq SRA project, generate genome indexes ##

# Create a tmux session for indexes generation
tmux new -s indexes

# In the STAR indexes directory (starIndexes), create symbolic links of GRCh38.primary_assembly.genome.fa and gencode.v45.primary_assembly.annotation.gtf (latest) files ##

ln -s ~/gencode/genomeFA/GRCh38.primary_assembly.genome.fa

