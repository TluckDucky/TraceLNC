=====================================================================
### Sequencing quality analyses using FastQC and Fastp algorithms ###
=====================================================================

## 1. FastQC of raw reads ##

vim fastqFiles_fastqc.sh

#!/bin/bash

while read project; do
        cd ${project}/rawData
        ls| grep " *.fastq" > fastqFiles.txt

        cd ../fastqc
        ln -s ../rawData/fastqFiles.txt

        for i in `cat fastqFiles.txt`; do ln -s ../rawData/${i}; done

        while read SRA; do
                echo "fastqc ${SRA} -t 32 -o ."
        done < fastqFiles.txt > fastqFiles_fastqc.sh

        jobs=$(wc -l < fastqFiles_fastqc.sh)
        parallel -j ${jobs} < fastqFiles_fastqc.sh >& fastqFiles_fastqc.log &
        cd ../..
done < projects.txt

bash fastqFiles_fastqc.sh

## 2. Fastp of raw reads ##

vim fastqFiles_fastp.sh

#!/bin/bash

while read project; do
        cd ${project}/fastp
        ln -s ../rawData/fastqFiles.txt

        for i in `cat fastqFiles.txt`; do ln -s ../rawData/${i}; done

        ls | grep -o "SRR[0-9]*" | sort -u > SRAProjectID.txt

        while read SRA; do
                echo "fastp -w 16 -h ${SRA}_fastp.html -j ${SRA}_fastp.json -i ${SRA}_1.fastq -I ${SRA}_2.fastq -o trimmed_${SRA}_1.fastq -O trimmed_${SRA}_2.fastq >& ${SRA}_fastp.log"
        done < SRAProjectID.txt > SRAProjectID_fastp.sh

        jobs=$(wc -l < SRAProjectID_fastp.sh)
        parallel -j ${jobs} < SRAProjectID_fastp.sh >& SRAProjectID_fastp.log &
        cd ../..
done < projects.txt

bash fastqFiles_fastp.sh

## 3. FastQC of trimmed reads ##

vim trimmed_fastqFiles_fastqc.sh

#!/bin/bash

while read project; do
        cd ${project}/fastp
        ls | grep "trimmed.*" > trimmed_fastqFiles.txt

        while read SRA; do
                echo "fastqc ${SRA} -t 32 -o ."
        done < trimmed_fastqFiles.txt > trimmed_fastqFiles_fastqc.sh

        jobs=$(wc -l < trimmed_fastqFiles_fastqc.sh)
        parallel -j ${jobs} < trimmed_fastqFiles_fastqc.sh >& trimmed_fastqFiles_fastqc.log &
        cd ../..
done < projects.txt

bash trimmed_fastqFiles_fastqc.sh
