#!/bin/bash

## 1. samtools ##
for i in `ls *Aligned.sortedByCoord.out.bam`; do echo "samtools index ${i} ${i}.bai" >> samIndex.sh; done

# Execute the code bellow in parallel (chage n to the number of samIndex.sh lines)
parallel -j n < samIndex.sh >& samIndex.log &

## 2. tin.py ##
for i in `ls *Aligned.sortedByCoord.out.bam`; do echo "tin.py -i $x -r gencode.v45.primary_assembly.annotation.bed >& ${x}_tinAnalysis.log" >> tin.sh; done

# Execute the code bellow in parallel (chage n to the number of samIndex.sh lines)
parallel -j n < tin.sh >& tin.log &

## 3 geneBody_coverage.py ##
for i in `ls *Aligned.sortedByCoord.out.bam`; do echo "geneBody_coverage.py -i $i -r gencode.v45.primary_assembly.annotation.bed -o ${i}_gbc >& ${i}_gbc.log" >> geneBody_coverage.sh; done

# Execute the code bellow in parallel (chage n to the number of samIndex.sh lines)
parallel -j n < geneBody_coverage.sh >& geneBody_coverage.log &

## 4 infer_experiment.py ##

ln -s /work2/group/trofo-zika/gencode/gencodeBed/gencode.v45.primary_assembly.annotation.bed
for i in `cat ../projects.txt`; do ll ../${i}/star/2nd/*STAR2ndPassMapping_Aligned.out.bam | sed 's/ /\t/g' | cut -f10 >> bewo_bamFiles.txt; done
for i in `cat bewo_bamFiles.txt`; do ln -s $i; done

for i in `cat bewo_bamFiles.txt`; do echo -e "\n\nData from ${i}:"; infer_experiment.py -r gencode.v45.primary_assembly.annotation.bed -i ${i}; done > inferExperiment.txt
