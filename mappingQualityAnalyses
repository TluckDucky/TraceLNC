while read x; do samtools index ${x} ${x}.bai < sortedByCoordBamFiles.txt; done

# 2. tin.py

while read x; do tin.py -i $x -r gencode.v45.primary_assembly.annotation.bed >& ${x}_tinAnalysis.log" < sortedByCoordBamFiles.txt; done

# 3 geneBody_coverage.py

while read x; do geneBody_coverage.py -i $i -r gencode.v45.primary_assembly.annotation.bed -o ${i}_gbc >& ${i}_gbc.log < sortedByCoordBamFiles.txt; done

