#!/bin/bash

# 1. Files required for index generation (indexes directory)

ln -s /work2/group/trofo-zika/gencode/gencodeFA/GRCh38.primary_assembly.genome.fa
ln -s /work2/group/trofo-zika/gencode/gencodeAnnotationGTF/gencode.v45.primary_assembly.annotation.gtf

# 2. List of number accession required for index generation (1st and 2nd directories)

cd ../1st

for i in `ls ../../fastp/trimmed*.fastq`; do ln -s $i; done

ls | grep -o "SRR[0-9]*" | sort -u > fastqFiles.txt

samplesList=fastqFiles.txt

cd ../2nd

for i in `ls ../../fastp/trimmed*.fastq`; do ln -s $i; done

ls | grep -o "SRR[0-9]*" | sort -u > fastqFiles.txt

samplesList=fastqFiles.txt

cd ..

clear; tree

cd indexes

# Execute the bash script

bash starFiles.sh

# Create the following function on the server and modify it accordingly to files.

STARanalyses () {
  STAR --runMode genomeGenerate --runThreadN 16 --genomeDir . --genomeFastaFiles GRCh38.primary_assembly.genome.fa --sjdbGTFfile gencode.v45.primary_assembly.annotation.gtf --sjdbOverhang $overHang >& STARindices_$project.log 2> STARindices_$project.err &&
  
  pathIndexes=$(pwd)
  cd ../1st && ln -s $pathIndexes &&
  
  while read x; do 
    STAR --runMode alignReads --runThreadN 16 --genomeDir indexes --readFilesIn trimmed_${x}_1.fastq trimmed_${x}_2.fastq --outFileNamePrefix ${x}_STAR1stPassMapping_ --outSAMtype BAM Unsorted --outFilterType BySJout --outFilterMultimapNmax 20 --outFilterMismatchNoverReadLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --quantMode TranscriptomeSAM --quantTranscriptomeBAMcompression 10 >& ${x}_STAR1passMapping.log
  done < $samplesList &&

  path1st=$(pwd)
  cd ../2nd && for i in $(ls $path1st/*_STAR1stPassMapping_SJ.out.tab); do ln -s $i; done
  ln -s $pathIndexes &&

  while read x; do 
    STAR --runMode alignReads --runThreadN 16 --genomeDir indexes --readFilesIn trimmed_${x}_1.fastq trimmed_${x}_2.fastq --limitBAMsortRAM 50000000000 --outFileNamePrefix ${x}_STAR2ndPassMapping_ --outSAMtype BAM Unsorted SortedByCoordinate --outFilterType BySJout --outFilterMultimapNmax 20 --outFilterMismatchNoverReadLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --sjdbFileChrStartEnd ${x}_STAR1stPassMapping_SJ.out.tab --quantMode TranscriptomeSAM --quantTranscriptomeBAMcompression 10 >& ${x}_STAR2passMapping.log
  done < $samplesList
}

