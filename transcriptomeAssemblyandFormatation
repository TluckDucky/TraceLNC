#!/bin/bash

# First, organize transcripts and exons using the taco output bed file

bedToGenePred assembly.bed /dev/stdout | genePredToGtf file /dev/stdin assembly_ordenado.gtf

# Second, remove transcripts assigned to scaffolds and contigs from organized and unorganized files

