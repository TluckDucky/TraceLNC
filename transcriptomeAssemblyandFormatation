#!/bin/bash

myScallop1stscript () {
        for project in `ls | grep -w "PRJNA[0-9]*"`; do \
                bioProject=${project}; \
                #mkdir ${bioProject}/scallop1st/; \
                #mkdir ${bioProject}/scallop1st_robust/; \
                #mkdir ${bioProject}/scallop1st_more_robust/; \
                #mkdir ${bioProject}/scallop1st_super_robust/; \
                mkdir ${bioProject}/scallop1st_final/; \
                cd ${bioProject}/star/2nd/; \
                dirBams=$(pwd); \
                #cd ../../scallop1st/; \
                #cd ../../scallop1st_robust/; \
                #cd ../../scallop1st_more_robust/; \
                #cd ../../scallop1st_super_robust/; \
                cd ../../scallop1st_final/; \

                for i in `ls ${dirBams}/*Aligned.sortedByCoord.out.bam`; do ln -s $i; done; \

                ll *Aligned.sortedByCoord.out.bam | grep -o "SRR[0-9]*" | sort -u > bamFiles.txt; \

                for i in `cat bamFiles.txt`; do echo "scallop -i ${i}_STAR2ndPassMapping_Aligned.sortedByCoord.out.bam -o ${i}_${bioProject}_scallop.gtf --library_type first --min_transcript_length_base 200 --min_mapping_quality 255 --min_splice_bundary_hits 10 --min_num_hits_in_bundle 20 --min_transcript_coverage 10 >& ${i}_${bioProject}_scallop.log 2> ${i}_${bioProject}_scallop.err"; done > ${bioProject}_scallop.sh;

                jobs=$(wc -l < ${bioProject}_scallop.sh)

                parallel -j ${jobs} < ${bioProject}_scallop.sh > ${bioProject}_scallop.log &

                cd ../..; \
        done
}

