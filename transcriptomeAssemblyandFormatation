make_hexamer_tab.py -c ${pcTranscripts} -n ${ncTranscripts} > human_hexamer.tsv &&

make_logitModel.py -c ${pcTranscripts} -n ${ncTranscripts} -o logitModel_ -x human_hexamer.tsv &&

cpat.py -r ${ref} -x human_hexamer.tsv --antisense -d logitModel_.logit.RData --top-orf=5 -g ${assembly} -o CPAT_codpot_ &&

awk '$10 < 0.364' CPAT_codpot_.ORF_prob.tsv > cpat_noncodingORFs.txt

awk '$10 >= 0.364' CPAT_codpot_.ORF_prob.tsv > cpat_codingORFs.txt

awk -F "::" '{print $1}' cpat_noncodingORFs.txt | sort -u > cpat_IDs_noncodingORFs.txt
awk -F "::" '{print $1}' cpat_codingORFs.txt | tail -n +2 | sort -u > cpat_IDs_codingORFs.txt
awk -F "::" '{print $1}' cpat_noORF.txt | sort -u > cpat_IDs_noORFs.txt

grep -Fxvf cpat_IDs_codingORFs.txt cpat_IDs_noncodingORFs.txt > cpat_putative_IDs_noncodingORFs.txt

cat cpat_IDs_noORFs.txt cpat_putative_IDs_noncodingORFs.txt | sort -u > cpat_nc_IDs.txt                                                                                                     

