#!/bin/bash

pcTranscripts="/work2/group/trofo-zika/gencode/gencodePcTranscripts/gencode.v45.pc_transcripts.fa"
ncTranscripts="/work2/group/trofo-zika/gencode/gencodeLncTranscripts/gencode.v45.lncRNA_transcripts.fa"
